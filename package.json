{
  "name": "dsh-whale-musume",
  "version": "2.5.0",
  "description": "鲸鱼娘桌面宠物（看板娘 / desktop pet mascot）for DeepSeek Harness：陪你写代码的 whale-girl 桌宠，桌面端与 Web 双端支持",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/generated",
    "assets/dsh-whale-moe.css",
    "assets/dsh-whale-moe.js",
    "assets/whale-moe-core.js",
    "assets/peek-calibration.json",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*test.mjs",
    "prepublishOnly": "node --test test/*test.mjs",
    "publish:npm": "npm publish --access public --registry=https://registry.npmjs.org",
    "qa": "node test/motion-qa.mjs && node test/cdp-whale-moe.mjs",
    "qa:soak": "node test/soak-work.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.6 <0.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.4": "unknown",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      },
      "note": "engines.dsh 是区间 >=0.1.0-rc.6 <0.4.0（DSH 按 semver includePrerelease 求值）：0.1.0-rc.6 起放行到 0.3.x，0.4.0 的预发布仍放行，0.4.0 正式版及更高版本不放行。安装门禁只读这个区间，dshReleases 仅供商城展示。0.2.0-rc.2 已在隔离 profile 上完成安装、加载与 DOM 契约验收；0.2.1-rc.1 / 0.2.1-rc.2 的 compatible 来自对 tag dsh-v0.2.1-rc.2 的静态契约核对，0.2.1-rc.3 来自对 app.asar 内 0.2.1-rc.3 客户端包复核全部 DOM 标记与 settings.section slot，均尚未在真实 Electron 桌面端复跑。0.2.x / 0.3.x 的其余版本按区间放行但未逐个验收，说明见 docs/desktop-0.2.1-rc.2-contract.md。"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mascot",
    "desktop-pet",
    "whale-girl",
    "cute"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sutera-Diffusus/dsh-whale-musume.git"
  },
  "bugs": {
    "url": "https://github.com/Sutera-Diffusus/dsh-whale-musume/issues"
  },
  "homepage": "https://github.com/Sutera-Diffusus/dsh-whale-musume#readme"
}
